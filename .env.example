# 서버 포트
PORT=3000

# Yahoo Finance 폴링 주기 (ms)
YAHOO_POLL_MS=15000

# 한국투자증권 OpenAPI (https://apiportal.koreainvestment.com)
# 미설정 시 국내 주식(삼성전자·SK하이닉스)은 Yahoo 지연 시세로 표시됩니다.
KIS_APP_KEY=
KIS_APP_SECRET=
# prod: 실전투자 / vps: 모의투자
KIS_ENV=prod

# 코스피200 선물 (KRX 야간파생시장 포함) — KIS 선물옵션 시세 폴링
# 최근월물 종목코드 (예: 101로 시작하는 코스피200 선물 코드, 만기 3·6·9·12월마다 갱신 필요
# — KIS 개발자 포털 또는 HTS에서 현재 최근월물 코드 확인)
KIS_FUT_CODE=
# 시장 구분코드: 주간 지수선물 F (야간시장 구분코드는 KIS 문서 확인 후 조정)
KIS_FUT_MARKET_CODE=F
# 선물 시세 폴링 주기 (ms)
KIS_FUT_POLL_MS=10000

# 노션 데일리 리포트 (미설정 시 reports/*.md 로컬 저장만)
# 1) https://www.notion.so/my-integrations 에서 내부 통합 생성 → 토큰 발급
# 2) 리포트를 쌓을 노션 부모 페이지에서 ⋯ → 연결 → 해당 통합 추가
# 3) 부모 페이지 URL 끝의 32자리 ID를 아래에 입력
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=

# 데일리 리포트 자동 생성 시각 (KST, HH:MM)
REPORT_TIME=16:00
